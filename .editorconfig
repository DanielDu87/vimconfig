# EditorConfig is awesome: https://EditorConfig.org

root = true

# 所有文件：只保留编码与换行等通用约定
# 缩进样式与宽度统一交给全局格式化器（见 ~/ai_coding_rules/coding-format.md），
# 不再按语言覆盖，避免与全局默认样式冲突
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown 硬换行依赖行尾空格，不自动去除
[*.md]
trim_trailing_whitespace = false
